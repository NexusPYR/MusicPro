<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/details_glass_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@android:color/transparent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="歌曲详情"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="标题"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_detail_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未知"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="艺术家"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_detail_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未知"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="文件大小"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_detail_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未知"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="文件路径"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tv_detail_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未知"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:layout_marginTop="2dp"
                android:textIsSelectable="true"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_copy_path"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="复制路径"
                android:textColor="@color/btn_scan_text" />

            <Button
                android:id="@+id/btn_close_details"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="确定"
                android:textColor="@color/btn_scan_text" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
